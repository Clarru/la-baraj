{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "la-baraj-world",
  "main": "index.ts",
  "compatibility_date": "2026-10-28",
  "durable_objects": {
    "bindings": [{ "name": "WorldRoom", "class_name": "WorldRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://la-baraj.vercel.app"
  }
}
